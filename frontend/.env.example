# demo = datos ilustrativos locales; api = exclusivamente el backend real.
VITE_DATA_MODE=demo
# /api usa el proxy de desarrollo. Si FastAPI tiene /api/v1, usa /api/api/v1.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
# Extensiones propuestas: dejar vacías hasta confirmarlas con el equipo backend.
VITE_OCCURRENCES_LIST_PATH=
VITE_CURATE_PATH=
VITE_USERS_PATH=
VITE_USER_UPDATE_PATH=
VITE_REFRESH_PATH=
VITE_ME_PATH=
# Guardado completo propuesto: habilitar solo al implementar estos contratos.
# Las rutas requieren {id}; PUT debe ser transaccional e idempotente.
VITE_RECORD_BUNDLE_PATH=
VITE_TAXON_BUNDLE_PATH=
VITE_MEDIA_BUNDLE_PATH=
