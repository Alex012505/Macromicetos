# api = backend real (predeterminado); demo = datos ilustrativos, con login real.
VITE_DATA_MODE=api
# /api usa el proxy de desarrollo. Si FastAPI tiene /api/v1, usa /api/api/v1.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
# Login JSON del backend. /auth/login recibe formulario OAuth2, no JSON.
VITE_LOGIN_PATH=/auth/login-json
# Contratos implementados en el backend integrado.
VITE_OCCURRENCES_LIST_PATH=/occurrences
VITE_CURATE_PATH=/occurrences/{id}/curation
VITE_USERS_PATH=/users
VITE_USER_UPDATE_PATH=/users/{id}
VITE_REFRESH_PATH=
VITE_ME_PATH=/auth/me
# Las rutas con {id} conservan los UUID del borrador durante los reintentos.
VITE_RECORD_BUNDLE_PATH=/record-bundles/{id}
VITE_TAXON_BUNDLE_PATH=/taxon-bundles/{id}
VITE_MEDIA_BUNDLE_PATH=/occurrences/{id}/media-bundle
