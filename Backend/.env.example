# Run python Backend/setup_postgres.py to create a private local .env.
APP_ENV=development
DATABASE_URL=postgresql+psycopg2://macromicetos_app:CHANGE_ME@127.0.0.1:5432/macromicetos
# Private random value, at least 32 characters. Do not commit .env.
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MULTIMEDIA_ROOT=
